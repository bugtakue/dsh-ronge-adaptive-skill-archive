{
  "name": "ronge-adaptive-skill-archive",
  "version": "2.6.4",
  "description": "荣哥技能卷轴收藏馆 / Ronge's Adaptive Skill Cockpit: a context-aware, self-evolving skill cockpit for DeepSeek Harness — recommendations with reasons, 10% exploration quota, category/skill affinity learning, live usage, plan/immersive modes, experience memory, pre-install safety scan, update diff/rollback and a 6,399-skill public index.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugtakue/ronge-adaptive-skill-archive.git"
  },
  "homepage": "https://github.com/bugtakue/ronge-adaptive-skill-archive#readme",
  "bugs": {
    "url": "https://github.com/bugtakue/ronge-adaptive-skill-archive/issues"
  },
  "author": "bugtakue",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "ai-agent",
    "context-aware",
    "productivity",
    "adaptive",
    "self-evolving",
    "skills-manager",
    "exploration"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "sources/*.json",
    "library/*.json",
    "test/fixtures/*.json",
    "mcp/*.mjs",
    "docs/cross-agent.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "eval:recommend": "node scripts/eval-recommend.mjs",
    "build:market-index": "node scripts/build-market-index.mjs",
    "start": "node scripts/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "bin": {
    "ronge-adaptive-skill-archive": "./scripts/cli.mjs"
  }
}
