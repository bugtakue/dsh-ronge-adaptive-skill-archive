{
  "name": "ronge-skill-studio",
  "version": "1.5.0",
  "description": "荣哥技能卷轴收藏馆（可沉浸式体验版本）: 6,399 public skills, context-aware recommendations, plan/immersive modes, experience memory + feedback, pre-install safety scan, update diff/rollback, and a completion chime for DeepSeek Harness.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugtakue/ronge-skill-studio.git"
  },
  "homepage": "https://github.com/bugtakue/ronge-skill-studio#readme",
  "bugs": {
    "url": "https://github.com/bugtakue/ronge-skill-studio/issues"
  },
  "author": "bugtakue",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "ai-agent",
    "context-aware",
    "productivity"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "sources/*.json",
    "library/*.json",
    "test/fixtures/*.json"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "eval:recommend": "node scripts/eval-recommend.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
