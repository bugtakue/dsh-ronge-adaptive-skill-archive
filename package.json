{
  "name": "dsh-ronge-adaptive-skill-archive",
  "version": "5.2.0",
  "description": "DSH-native skill intelligence cockpit: task decomposition, cross-domain multi-skill composition, skill authoring, local recommendations and safety scans for DeepSeek Harness.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugtakue/dsh-ronge-adaptive-skill-archive.git"
  },
  "homepage": "https://github.com/bugtakue/dsh-ronge-adaptive-skill-archive#readme",
  "bugs": {
    "url": "https://github.com/bugtakue/dsh-ronge-adaptive-skill-archive/issues"
  },
  "author": "bugtakue",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "ai-agent",
    "context-aware",
    "productivity",
    "adaptive",
    "self-evolving",
    "skills-manager",
    "exploration",
    "skill-orchestration",
    "skill-authoring",
    "skill-intelligence"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "sources/*.json",
    "test/fixtures/*.json",
    "mcp/*.mjs",
    "docs/cross-agent.md",
    "docs/eval.md",
    "library/repo-metadata.json",
    "test/fixtures/discover-cases.json",
    "docs/dsh-compatibility.md",
    "lib/**/*.js",
    "docs/benchmark.md",
    "docs/claims.md",
    "docs/attribution.md",
    "docs/intelligence-architecture.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "PRIVACY.md",
    "library/domain-packs.json",
    "library/capability-index.json",
    "library/skills-index.json",
    "library/NOTICE.md",
    "library/README.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "eval:recommend": "node scripts/eval-recommend.mjs",
    "build:market-index": "node scripts/build-market-index.mjs",
    "start": "node scripts/cli.mjs",
    "eval:real": "node scripts/eval-real.mjs",
    "eval:discover": "node scripts/eval-discover.mjs",
    "check:dsh": "node scripts/dsh-compat-check.mjs",
    "build:capability": "node scripts/build-capability-index.mjs",
    "eval:benchmark": "node scripts/benchmark.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "bin": {
    "dsh-ronge-adaptive-skill-archive": "./scripts/cli.mjs",
    "dsh-ronge-skill-mcp": "./mcp/server.mjs"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20"
  }
}
