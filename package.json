{
  "name": "ronge-adaptive-skill-archive",
  "version": "2.0.0",
  "description": "荣哥技能卷轴收藏馆（可沉浸式体验版本）/ Ronge's Adaptive Skill Cockpit (Immersive Edition): 6,399 public skills, adaptive contextual recommendations with self-evolving weights, plan/immersive modes, pre-install safety scan, update diff/rollback, experience memory + feedback, and a completion chime for DeepSeek Harness.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugtakue/ronge-adaptive-skill-archive.git"
  },
  "homepage": "https://github.com/bugtakue/ronge-adaptive-skill-archive#readme",
  "bugs": {
    "url": "https://github.com/bugtakue/ronge-adaptive-skill-archive/issues"
  },
  "author": "bugtakue",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "ai-agent",
    "context-aware",
    "productivity",
    "adaptive",
    "self-evolving",
    "skills-manager"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "sources/*.json",
    "library/*.json",
    "test/fixtures/*.json"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "eval:recommend": "node scripts/eval-recommend.mjs",
    "build:market-index": "node scripts/build-market-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
